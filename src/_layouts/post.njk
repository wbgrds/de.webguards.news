---
layout: base
---

<article class="post">
    <header class="post-header">
        <h1>{{ title }}</h1>
        <div class="post-meta">
            <time datetime="{{ date | htmlDateString }}">
                {{ date | dateFilter }}
            </time>
            {% if author %}
                <span class="post-author">von {{ author }}</span>
            {% endif %}
        </div>
    </header>

    <div class="post-content">
        {{ content | safe }}
    </div>

    <footer class="post-footer">
        <a href="/blog/" class="back-link">← Zurück zum Blog</a>
    </footer>
</article>
